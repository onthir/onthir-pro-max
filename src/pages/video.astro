---
import Layout from '../layouts/Layout.astro';
import Channels from '../components/Channels.astro';
import ProfileRail from '../components/ProfileRail.astro';
---
<Layout title="Bibek Bhandari | Video" active="video">
  <div class="grid">
    <div class="col-main">
      <section class="hero card">
        <h1>Video</h1>
        <p class="lead">
          I post video work across a few places — short films, video poems,
          and the occasional walkthrough. Follow wherever fits.
        </p>
      </section>
      <Channels />
    </div>
    <div class="col-rail"><ProfileRail /></div>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: var(--col-mid) var(--col-right);
    gap: var(--gap);
    align-items: start;
    justify-content: center;
  }
  .col-rail { position: sticky; top: calc(var(--nav-h) + 16px); }

  .hero { padding: 24px; }
  .hero h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .lead {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.5;
    max-width: 60ch;
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: minmax(0, var(--col-mid)); justify-content: center; }
    .col-rail { display: none; }
  }
</style>
