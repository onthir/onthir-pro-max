---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/profile/Projects.astro';
import ProfileRail from '../components/ProfileRail.astro';
---
<Layout title="Bibek Bhandari | Projects" active="projects">
  <div class="grid">
    <div class="col-main">
      <Projects />
    </div>
    <div class="col-rail"><ProfileRail /></div>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr var(--col-right);
    gap: var(--gap);
    align-items: start;
  }
  .col-rail { position: sticky; top: calc(var(--nav-h) + 16px); }
  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
    .col-rail { position: static; }
  }
</style>
