---
import Avatar from './Avatar.astro';
import { content } from '../lib/content.ts';
import { isExternal } from '../lib/url.ts';
const { people } = content;
---
<section class="card channels-card">
  <header class="head">
    <h2>Channels</h2>
    <p class="tiny muted">Where I post video work</p>
  </header>
  <ul class="rows">
    {people.map((p) => (
      <li class="row">
        <Avatar initial={p.initial} src={p.avatar} alt={p.name} size={56} />
        <div class="meta">
          <p class="pname">{p.name}</p>
          <p class="psub">{p.subtitle}</p>
        </div>
        <a
          class="btn btn-secondary"
          href={p.url}
          target={isExternal(p.url) ? '_blank' : undefined}
          rel={isExternal(p.url) ? 'noopener noreferrer' : undefined}
        >+ Follow</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .channels-card { padding: 24px; }
  .head { margin-bottom: 12px; }
  .head h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .head .tiny { margin: 2px 0 0; }
  .rows { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--divider);
  }
  .row:last-child { border-bottom: none; padding-bottom: 0; }
  .meta { min-width: 0; }
  .pname {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  .psub {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.3;
  }
  @media (max-width: 540px) {
    .row { grid-template-columns: 48px 1fr; }
    .row .btn { grid-column: 1 / -1; justify-self: stretch; }
  }
</style>
