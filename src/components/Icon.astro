---
// Inline SVG icon set, sized via the `size` prop (defaults to 24).
// Stroke-based outline icons matching LinkedIn's visual weight.
type Props = {
  name:
    | 'home' | 'home-fill'
    | 'projects' | 'projects-fill'
    | 'writing' | 'writing-fill'
    | 'video' | 'video-fill'
    | 'about' | 'about-fill'
    | 'search' | 'caret' | 'plus' | 'globe' | 'lock'
    | 'photo' | 'video-post' | 'article' | 'event'
    | 'like' | 'comment' | 'repost' | 'send'
    | 'thumbs-filled' | 'celebrate' | 'support'
    | 'pencil' | 'plus-thick' | 'arrow' | 'dot' | 'briefcase' | 'cap'
    | 'onthir';
  size?: number;
  class?: string;
};
const { name, size = 24, class: cls = '' } = Astro.props;
const s = size;
---
{name === 'onthir' && (
  <svg width={s} height={s} viewBox="0 0 24 24" class={cls} aria-hidden="true">
    <rect width="24" height="24" rx="4" fill="#0a66c2"/>
    <text
      x="12" y="17"
      text-anchor="middle"
      fill="#fff"
      font-family="Source Sans 3, system-ui, sans-serif"
      font-weight="700"
      font-size="14"
      letter-spacing="-0.02em"
    >O</text>
  </svg>
)}
