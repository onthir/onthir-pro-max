---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { content, type Post } from '../lib/content.ts';
import { isExternal } from '../lib/url.ts';

type Props = { post: Post };
const { post } = Astro.props;
const { profile } = content;
---
<article class="post card">
  <header class="post-head">
    <a href="/profile" class="post-author">
      <Avatar initial={profile.name[0]} src={profile.avatar} alt={profile.name} size={48} />
    </a>
    <div class="post-meta">
      <a href="/profile" class="post-name">{profile.name}</a>
      <p class="post-headline tiny">{profile.headline}</p>
      <p class="post-time tiny">
        {post.timeAgo} · <Icon name="globe" size={12} class="inline" />
      </p>
    </div>
    <button type="button" class="more" aria-label="More">⋯</button>
    <button type="button" class="close" aria-label="Dismiss">×</button>
  </header>

  <div class="post-body">
    {post.body.split('\n').map((para) => <p>{para}</p>)}
  </div>

  {post.media && post.media.kind === 'image' && (
    <div class="post-media" style={`aspect-ratio:${post.media.ratio};`}>
      <span class="media-art" aria-hidden="true"></span>
      <span class="media-label tiny">{post.media.label}</span>
    </div>
  )}
  {post.media && post.media.kind === 'video' && post.media.provider === 'youtube' && (
    <div class="post-media post-video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${post.media.id}`}
        title={post.media.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      />
    </div>
  )}
  {post.media && post.media.kind === 'article' && (
    <a
      href={post.media.url ?? '#'}
      class="post-article"
      target={isExternal(post.media.url) ? '_blank' : undefined}
      rel={isExternal(post.media.url) ? 'noopener noreferrer' : undefined}
    >
      <div class="art-thumb" aria-hidden="true"></div>
      <div class="art-body">
        <p class="art-title">{post.media.title}</p>
        <p class="art-sub tiny">{post.media.subtitle}</p>
        <p class="art-domain tiny">{post.media.domain}{post.media.meta ? ` · ${post.media.meta}` : ''}</p>
      </div>
    </a>
  )}

  <div class="reactions">
    <span class="reaction-icons" aria-hidden="true">
      <Icon name="thumbs-filled" size={16} />
      <Icon name="celebrate" size={16} />
      <Icon name="support" size={16} />
    </span>
    <span class="reaction-count">{post.likes}</span>
    <span class="dot">·</span>
    <span class="reaction-count">{post.comments} comments</span>
    <span class="dot">·</span>
    <span class="reaction-count">{post.reposts} reposts</span>
  </div>

  <div class="post-actions">
    <button type="button" class="post-action">
      <Icon name="like" size={20} /> <span>Like</span>
    </button>
    <button type="button" class="post-action">
      <Icon name="comment" size={20} /> <span>Comment</span>
    </button>
    <button type="button" class="post-action">
      <Icon name="repost" size={20} /> <span>Repost</span>
    </button>
    <button type="button" class="post-action">
      <Icon name="send" size={20} /> <span>Send</span>
    </button>
  </div>
</article>

<style>
  .post { margin-top: 8px; }

  .post-head {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 8px;
    align-items: center;
    padding: 12px 16px 4px;
  }
  .post-author { display: inline-flex; }
  .post-meta { min-width: 0; }
  .post-name {
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .post-name:hover { color: var(--brand); }
  .post-headline { margin: 1px 0 0; line-height: 1.3; }
  .post-time { margin: 1px 0 0; line-height: 1.3; display: inline-flex; align-items: center; gap: 4px; }
  .post-time :global(svg) { vertical-align: middle; }

  .more, .close {
    width: 32px; height: 32px;
    border-radius: 50%;
    color: var(--text-2);
    font-size: 18px;
    line-height: 1;
  }
  .more:hover, .close:hover { background: var(--surface-hover); color: var(--text); }

  .post-body {
    padding: 4px 16px 8px;
    font-size: 14px;
    color: var(--text);
  }
  .post-body p { margin: 0 0 4px; white-space: pre-wrap; }

  .post-media {
    position: relative;
    background: #1a1a1a;
    margin: 0;
  }
  .media-art {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 80% at 30% 30%, rgba(176,140,84,0.45), transparent 70%),
      radial-gradient(60% 80% at 80% 80%, rgba(194,10,31,0.55), transparent 65%),
      linear-gradient(180deg, #1a1a1a, #0b0b0b);
  }
  .media-label {
    position: absolute;
    left: 12px; bottom: 12px;
    color: rgba(255,255,255,0.7);
  }

  .post-video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .post-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .post-article {
    display: grid;
    grid-template-columns: 132px 1fr;
    margin: 0;
    background: var(--surface-alt);
    color: var(--text);
  }
  .post-article:hover { text-decoration: none; background: #f3d6d6; }
  .art-thumb {
    aspect-ratio: 1.4;
    background:
      radial-gradient(80% 80% at 30% 30%, #b08c54, transparent 70%),
      linear-gradient(135deg, #c20a1f, #3b0509);
  }
  .art-body { padding: 12px 16px; align-self: center; }
  .art-title { margin: 0; font-weight: 600; font-size: 14px; }
  .art-sub { margin: 2px 0 0; }
  .art-domain { margin: 4px 0 0; }

  .reactions {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px 4px;
    font-size: 12px;
    color: var(--text-2);
  }
  .reaction-icons {
    display: inline-flex;
    align-items: center;
  }
  .reaction-icons :global(svg) {
    margin-left: -3px;
    border-radius: 50%;
    background: var(--surface);
  }
  .reaction-icons :global(svg):first-child { margin-left: 0; }
  .reaction-count { font-weight: 400; }
  .dot { padding: 0 2px; color: var(--text-3); }

  .post-actions {
    display: flex;
    justify-content: space-around;
    border-top: 1px solid var(--divider);
    padding: 4px 8px;
  }
  .post-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 4px;
    color: var(--text-2);
    font-weight: 600;
    font-size: 14px;
  }
  .post-action:hover { background: var(--surface-hover); color: var(--text); }
  @media (max-width: 720px) {
    .post-action span { display: none; }
  }
</style>
