---
import Avatar from './Avatar.astro';
import { content } from '../lib/content.ts';
import { isExternal } from '../lib/url.ts';

const { people } = content;
---
<aside class="rail">
  <section class="card people">
    <h3>People you may know</h3>
    <p class="tiny muted">From your industry</p>
    <ul class="people-list">
      {people.map((p) => (
        <li>
          <span class="banner" aria-hidden="true"></span>
          <span class="avi-wrap">
            <Avatar initial={p.initial} src={p.avatar} alt={p.name} size={56} ring />
          </span>
          <p class="pname">{p.name}</p>
          <p class="tiny">{p.subtitle}</p>
          <a
            class="btn btn-secondary small"
            href={p.url}
            target={isExternal(p.url) ? '_blank' : undefined}
            rel={isExternal(p.url) ? 'noopener noreferrer' : undefined}
          >+ Follow</a>
        </li>
      ))}
    </ul>
    <a class="show-all" href="/video">Show all →</a>
  </section>
</aside>

<style>
  .rail { display: flex; flex-direction: column; gap: 8px; }

  .people { padding: 12px 0 4px; }
  .people h3 { margin: 0 16px; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .people .tiny.muted { margin: 2px 16px 8px; }
  .people-list { display: flex; flex-direction: column; }
  .people-list li {
    position: relative;
    padding: 0 16px 16px;
    border-bottom: 1px solid var(--divider);
    margin-bottom: 8px;
    text-align: center;
  }
  .people-list li:last-child { border-bottom: none; margin-bottom: 0; }
  .banner {
    display: block;
    height: 56px;
    margin: 0 -16px 0;
    background:
      radial-gradient(60% 80% at 30% 30%, rgba(176,140,84,0.4), transparent 60%),
      linear-gradient(135deg, #c20a1f, #3b0509);
  }
  .avi-wrap {
    display: inline-block;
    margin-top: -28px;
  }
  .pname { margin: 8px 0 0; font-size: 14px; font-weight: 600; color: var(--text); }
  .pname + .tiny { margin: 1px 0 8px; }
  .btn.small { height: 28px; padding: 0 12px; font-size: 13px; width: 100%; }

  .show-all {
    display: block;
    padding: 12px 16px;
    color: var(--text-2);
    font-weight: 600;
    border-top: 1px solid var(--divider);
  }
  .show-all:hover { color: var(--brand); background: var(--surface-hover); text-decoration: none; }
</style>
