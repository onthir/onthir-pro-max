---
import Icon from './Icon.astro';
import { content } from '../lib/content.ts';
import { isExternal } from '../lib/url.ts';
const { links, today } = content;
---
<aside class="news card" aria-label="Around the web">
  <header class="news-head">
    <h2>{links.title}</h2>
    <button type="button" class="info" aria-label="About">i</button>
  </header>
  <p class="sub muted">{links.subtitle}</p>
  <ul class="items">
    {links.items.map((item) => (
      <li>
        <a
          href={item.url}
          target={isExternal(item.url) ? '_blank' : undefined}
          rel={isExternal(item.url) ? 'noopener noreferrer' : undefined}
        >
          <span class="item-label">{item.label}</span>
          <span class="item-sub tiny">{item.subtitle}</span>
        </a>
      </li>
    ))}
  </ul>
  <button type="button" class="show-more">
    Show more <Icon name="caret" size={12} />
  </button>
</aside>

<aside class="today card" aria-label="Today">
  <header class="news-head">
    <h2>{today.title}</h2>
    <button type="button" class="info" aria-label="About">i</button>
  </header>
  <ul class="puzzles">
    {today.items.map((p) => (
      <li>
        <span class="puzzle-icon" aria-hidden="true">{p.icon}</span>
        <div>
          <p class="puzzle-label">{p.label}</p>
          <p class="puzzle-sub tiny">{p.subtitle}</p>
        </div>
      </li>
    ))}
  </ul>
</aside>

<footer class="rail-footer">
  <ul>
    <li><a href="/profile">About</a></li>
    <li><a href="mailto:bibekpro13@gmail.com">Contact</a></li>
    <li><a href="https://linkedin.com/in/bhandarib" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    <li><a href="https://github.com/" target="_blank" rel="noopener noreferrer">GitHub</a></li>
    <li><a href="/Bibek-Bhandari-Resume.pdf" target="_blank" rel="noopener">Resume</a></li>
  </ul>
  <p class="brand-line">
    <span class="logo-mini" aria-hidden="true">O</span>
    Onthir · Bibek Bhandari © 2026
  </p>
</footer>

<style>
  .news, .today { padding: 12px 0 4px; }
  .today { margin-top: 8px; }

  .news-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 12px 0 16px;
  }
  .news h2, .today h2 {
    margin: 0; font-size: 16px; font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .info {
    width: 24px; height: 24px;
    border-radius: 50%;
    color: var(--text-2);
    font-style: italic;
    font-size: 13px;
    line-height: 1;
  }
  .info:hover { background: var(--surface-hover); color: var(--text); }
  .sub { margin: 0 16px 4px; font-size: 12px; }

  .items { padding: 4px 0; }
  .items li a {
    display: block;
    padding: 6px 16px;
    color: var(--text);
    font-size: 14px;
  }
  .items li a:hover { background: var(--surface-hover); text-decoration: none; }
  .item-label {
    display: block;
    font-weight: 600;
    line-height: 1.3;
    position: relative;
    padding-left: 12px;
  }
  .item-label::before {
    content: '';
    position: absolute;
    left: 4px; top: 50%;
    width: 3px; height: 3px;
    background: var(--text-2);
    border-radius: 50%;
    transform: translateY(-50%);
  }
  .item-sub { display: block; padding-left: 12px; margin-top: 1px; }

  .show-more {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 12px 16px;
    width: 100%;
    color: var(--text-2);
    font-weight: 600;
    border-radius: 4px;
  }
  .show-more:hover { background: var(--surface-hover); color: var(--text); }

  .puzzles { padding: 4px 0 8px; }
  .puzzles li {
    display: flex;
    gap: 12px;
    padding: 8px 16px;
  }
  .puzzles li:hover { background: var(--surface-hover); cursor: pointer; }
  .puzzle-icon {
    width: 32px; height: 32px;
    background: var(--surface-alt);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .puzzle-label { margin: 0; font-size: 13px; font-weight: 600; }
  .puzzle-sub { margin: 1px 0 0; }

  .rail-footer {
    margin-top: 16px;
    padding: 8px 4px;
    color: var(--text-2);
    font-size: 12px;
  }
  .rail-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-bottom: 8px;
  }
  .rail-footer ul li a {
    color: var(--text-2);
    font-weight: 400;
    font-size: 12px;
  }
  .rail-footer ul li a:hover { color: var(--brand); }
  .brand-line {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: var(--text-2);
  }
  .logo-mini {
    background: var(--brand);
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    font-style: normal;
  }
</style>
